@startuml DB
' ER diagram — transcribed from the paper cards
hide circle
skinparam linetype ortho
skinparam roundcorner 6
skinparam class {
  BackgroundColor White
  BorderColor #444
  ArrowColor #444
}

' ===== Core entities =====
entity "users" as users {
  * id : uuid <<PK>>
  --
  * std_id : str <<unique>>  (e.g. 6709681xxx)
}

entity "courses" as courses {
  * id : uuid <<PK>>
  --
  * code : str <<unique>>  (e.g. CS100)
  * name : str
  desc : str
}

entity "topics" as topics {
  * id : uuid <<PK>>
  --
  * name : str
  desc : str
}

entity "resources" as resources {
  * id : uuid <<PK>>
  --
  * kind : enum(file, url)
  file_path : str | None
  url : str | None
  * name : str
  desc : str
  * timestamp : datetime
}

entity "logs" as logs {
  * id : uuid <<PK>>
  --
  * type : enum(info, warn, error, critical)
  * content : str
  * timestamp : datetime
}

' ===== Join / relation tables =====
entity "relation_topic_course" as rtc {
  * id : uuid <<PK>>
  --
  * topic_id : uuid <<FK>>
  * course_id : uuid <<FK>>
  * seq_no : int
  ..
  <<unique>> (course_id, topic_id)
  <<unique>> (course_id, seq_no)
}

entity "relation_res_topics" as rrt {
  * id : uuid <<PK>>
  --
  * res_id : uuid <<FK>>
  * topic_id : uuid <<FK>>
  desc : str | None
  timestamp : datetime | None
  ..
  <<unique>> (res_id, topic_id)
}

entity "prerequisites" as prereq {
  * id : uuid <<PK>>
  --
  * course_id : uuid <<FK>>
  * prerequisite_id : uuid <<FK>>
  * timestamp : datetime
  ..
  <<unique>> (course_id, prerequisite_id)
  <<check>> course_id <> prerequisite_id
}

entity "topic_relations" as trel {
  * id : uuid <<PK>>
  --
  * topic_id : uuid <<FK>>
  * req_topic_id : uuid <<FK>>
  * timestamp : datetime
  ..
  <<unique>> (topic_id, req_topic_id)
  <<check>> topic_id <> req_topic_id
}

entity "progress" as progress {
  ' sparse: row exists only when the user marked the topic done
  * user_id : uuid <<PK, FK>>
  * topic_id : uuid <<PK, FK>>
  --
  * done_at : datetime
}

' ===== Relationships =====
' course <-> topic (M:N, ordered by seq_no)
courses ||--o{ rtc : contains
topics  ||--o{ rtc : appears in

' resource <-> topic (M:N)
resources ||--o{ rrt : attached to
topics    ||--o{ rrt : has

' course -> course (prerequisite, self M:N)
courses ||--o{ prereq : course_id
courses ||--o{ prereq : prerequisite_id

' topic -> topic (required topic, self M:N)
topics ||--o{ trel : topic_id
topics ||--o{ trel : req_topic_id

' user <-> topic (learning progress)
users  ||--o{ progress : tracks
topics ||--o{ progress : tracked by

' logs is standalone (no FK)

@enduml
