courseMapper: {
  shape: class
  label: "<<@Component>>\nCourseMapper"
  "+toSkillTreeDTO(courses: List<Course>, prerequisites: List<Prerequisite>)": SkillTreeDTO
  "+toCourseItemDTO(course: Course)": CourseItemDTO
  "+toPrerequisiteDTO(prerequisite: Prerequisite)": PrerequisiteDTO
  "+toDetailDTO(course: Course, courseTopics: List<CourseTopic>, topicRelations: List<TopicRelation>, resourceTopics: List<ResourceTopic>)": CourseDetailDTO
  "+toTopicItemDTO(courseTopic: CourseTopic, prerequisites: List<UUID>, resources: List<ResourceDTO>)": TopicItemDTO
  "+toResourceDTO(resource: Resource)": ResourceDTO
}
