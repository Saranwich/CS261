shape : sequence_diagram

cstu_student : CSTU Students
cstu_student.shape: person

view : Views
view_controller: viewControllers
controller: Controllers
model : Models
services : Services
cache : Cache; cache.shape : cylinder
repository: Repository
DB : RelationalDB; DB.shape : cylinder

กดเลือกรายวิชา:{
    cstu_student -> view :กดปุ่มเลือกรายวิชา
    view -> view_controller :เรียกฟังชั่นที่รับผิดชอบการเลือก
    view_controller -> controller: fetching api
    controller -> model : เปลี่ยนเป็น DTO
    model -> controller : ได้ DTO
    controller -> services : เรียกขอข้อมูลDTO
    services -> cache: ค้นหาใน cache

    cache_hit_case: "เจอข้อมูลใน cache" {
        cache -> services: เจอ คืนข้อมูลกลับมา
    }

    cache_miss_case: "ไม่เจอข้อมูลในแคช" {
        cache -> services: ไม่เจอ
        services -> repository:เรียกค้นหาจากDB
        repository -> DB:จัดการคำร้องß
        DB -> repository: ข้อมูล
        repository -> services: ข้อมูลจากฐานข้อมูล
        services -> cache: บันทึกผลลง cache จากรอบนี้
    }
    services -> controller : ส่งข้อมูล
    controller -> model: แปลงข้อมูลเป็น ResponseDTO
    model -> controller: ResponseDTO
    controller -> view_controller: ข้อมูลที่ fetch
    view_controller->view: นำข้อมูลไปจัดการเรียกฟังชั่นที่เกี่ยวกับการแสดงผล
    view->cstu_student: เห็นผลลัพธ์รายวิชา
}